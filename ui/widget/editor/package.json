{
  "name": "@ui-widgets/editor",
  "label": "Editor",
  "version": "0.0.0",
  "description": "Составной редактор с заголовком и командами приложения",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
