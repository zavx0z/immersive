{
  "name": "@ui-widgets/inspector",
  "label": "Inspector",
  "version": "0.0.0",
  "description": "Инспектор категорий и панелей с поиском и сохраняемым содержимым",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @immersive/headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@jsx-compiler/session": "workspace:*",
    "@ui-buttons/button": "workspace:*",
    "@ui-buttons/icon-button": "workspace:*",
    "@ui-fields/text-field": "workspace:*",
    "@ui-themes-icons/search": "workspace:*"
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@ui-themes-icons/run": "workspace:*",
    "@ui/typography": "workspace:*",
    "@ui/widgets": "workspace:*"
  }
}
