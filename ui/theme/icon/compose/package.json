{
  "name": "@zavx0z/immersive-ui-theme-icon-compose",
  "label": "iconSvg",
  "version": "0.0.0",
  "description": "Собирает SVG data URL размером 24×24 из векторного содержимого и цвета штрихов",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-tech-svg-encode": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-ui-theme-icon": "workspace:*"
  }
}
