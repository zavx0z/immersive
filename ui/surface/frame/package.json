{
  "name": "@ui-surfaces/frame",
  "label": "Frame",
  "version": "0.0.0",
  "description": "Рамка рабочей области с заголовком и элементами управления",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
