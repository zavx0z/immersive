  },
  "dependencies": {
    "@jsx-compiler/session": "workspace:*",
    "@ui-surfaces-chrome/assert-surface-actions": "workspace:*",
    "@ui-surfaces-chrome/body": "workspace:*",
    "@ui-surfaces-chrome/button": "workspace:*",
    "@ui-surfaces-chrome/header": "workspace:*",
    "@ui-surfaces-chrome/navigation": "workspace:*",
    "@ui-surfaces-chrome/owner": "workspace:*",
    "@ui-surfaces-chrome/title": "workspace:*"
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@ui/typography": "workspace:*",
    "@ui/surfaces": "workspace:*"
  }
}
