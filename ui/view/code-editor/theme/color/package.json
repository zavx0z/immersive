{
  "name": "@zavx0z/immersive-ui-view-code-editor-theme-color",
  "label": "themeColor",
  "version": "0.0.0",
  "description": "Возвращает нормализованный HEX-цвет темы редактора либо переданный запасной цвет",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-view-code-editor-syntax-theme-data": "workspace:*",
    "@zavx0z/immersive-tech-color-hex-valid": "workspace:*",
    "@zavx0z/immersive-tech-color-hex-normalize": "workspace:*"
  }
}
