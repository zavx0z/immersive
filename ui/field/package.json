    "@ui-fields/color-field": "workspace:*",
    "@ui-fields/color-picker-field": "workspace:*",
    "@ui-fields/cycle-field": "workspace:*",
    "@ui-fields/field-group": "workspace:*",
    "@ui-fields/matrix-field": "workspace:*",
    "@ui-fields/number-field": "workspace:*",
    "@ui-fields/path-field": "workspace:*",
    "@ui-fields/reference-field": "workspace:*",
    "@ui-fields/select-field": "workspace:*",
    "@ui-fields/slider-field": "workspace:*",
    "@ui-fields/switch-field": "workspace:*",
    "@ui-fields/text-field": "workspace:*",
    "@ui-fields/vector-field": "workspace:*",
    "@jsx-compiler/session": "workspace:*"
  },
  "devDependencies": {
