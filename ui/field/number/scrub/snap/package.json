{
  "name": "@zavx0z/immersive-ui-field-number-scrub-snap",
  "label": "snapNumberValue",
  "version": "0.0.0",
  "description": "Привязывает число к шагу диапазона, сохраняя его граничные и неконечные значения",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-ui-field-number-value-soft-range": "workspace:*",
    "@zavx0z/immersive-ui-field-number-value-round": "workspace:*"
  }
}
