{
  "name": "@zavx0z/immersive-ui-component-view",
  "label": "view",
  "version": "0.0.0",
  "description": "Представления показывают данные и предоставляют их собственные способы взаимодействия.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-view-code-editor": "workspace:*",
    "@zavx0z/immersive-ui-component-view-list": "workspace:*",
    "@zavx0z/immersive-ui-component-view-table": "workspace:*",
    "@zavx0z/immersive-ui-component-view-timeline": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
