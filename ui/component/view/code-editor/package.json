{
  "name": "@immersive-ui-component-view/code-editor",
  "label": "CodeEditor",
  "version": "0.0.0",
  "description": "Редактор исходного текста с подсветкой, выделением и общей моделью редактирования",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @immersive/headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@immersive-jsx-compiler/session": "workspace:*",
    "@immersive-ui-component-view-code-editor/highlighter": "workspace:*",
    "@immersive-ui-component-view-code-editor/validate": "workspace:*",
    "@immersive-ui-component-view-code-editor/view-model": "workspace:*",
    "@immersive-ui-component/badge": "workspace:*",
    "@immersive-tech/text-editor": "workspace:*",
    "@zavx0z/highlighter": "^0.1.0"
  },
  "peerDependencies": {
    "@immersive/component": "workspace:*",
    "@immersive/dom": "workspace:*"
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@immersive-ui-component/view": "workspace:*"
  }
}
