{
  "name": "@zavx0z/immersive-ui-component-view-code-editor",
  "label": "CodeEditor",
  "version": "0.0.0",
  "description": "Редактор исходного текста с подсветкой, выделением и общей моделью редактирования",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor-highlighter": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor-validate": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor-view-model": "workspace:*",
    "@zavx0z/immersive-ui-component-badge": "workspace:*",
    "@zavx0z/immersive-tech-text-editor": "workspace:*",
    "@zavx0z/highlighter": "^0.1.0"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-view": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-renderer-html": "workspace:*"
  }
}
