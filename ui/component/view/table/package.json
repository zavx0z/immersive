{
  "name": "@zavx0z/immersive-ui-component-view-table",
  "label": "Table",
  "version": "0.0.0",
  "description": "Таблица строк и столбцов с управляемым выбором",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.tsx",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-view-table-normalize-table-selection": "workspace:*",
    "@zavx0z/immersive-ui-component-view-table-selection-after-click": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-view": "workspace:*"
  }
}
