{
  "name": "@immersive-ui-component-surface/window",
  "label": "Window",
  "version": "0.0.0",
  "description": "Сохраняемое окно с перемещением, изменением размера и общим состоянием видимости",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
