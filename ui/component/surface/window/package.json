{
  "name": "@zavx0z/immersive-ui-component-surface-window",
  "label": "Window",
  "version": "0.0.0",
  "description": "Сохраняемое окно с перемещением, изменением размера и общим состоянием видимости",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.tsx",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-button": "workspace:*",
    "@zavx0z/immersive-ui-theme-icon-minus": "workspace:*",
    "@zavx0z/immersive-ui-component-feedback-notification": "workspace:*"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-field-text": "workspace:*",
    "@zavx0z/immersive-ui-component-surface": "workspace:*",
    "@zavx0z/immersive-renderer-html": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-window-control": "workspace:*"
  }
}
