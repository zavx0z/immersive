{
  "name": "@zavx0z/immersive-ui-component-surface-chrome",
  "label": "chrome",
  "version": "0.0.0",
  "description": "Части оболочки поверхности создают её заголовок, навигацию, действия и тело.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-surface-chrome-body": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-button": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-header": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-navigation": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-owner": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-chrome-title": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-surface": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
