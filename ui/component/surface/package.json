{
  "name": "@zavx0z/immersive-ui-component-surface",
  "label": "surface",
  "version": "0.0.0",
  "description": "Поверхности размещают содержимое и управление в Document приложения.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-surface-chrome": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-frame": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-pane": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-panel": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-tab": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-window": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-window-control": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
