{
  "name": "@zavx0z/immersive-ui-component-button",
  "label": "button",
  "version": "0.0.0",
  "description": "Кнопки и переключатели сохраняют общий протокол доступности и представления.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-button-basic": "workspace:*",
    "@zavx0z/immersive-ui-component-button-icon": "workspace:*",
    "@zavx0z/immersive-ui-component-button-toggle-group": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-theme-icon-run": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
