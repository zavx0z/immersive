{
  "name": "@zavx0z/immersive-ui-component-widget-settings",
  "label": "Настройки",
  "version": "0.0.0",
  "description": "Настройки с боковыми разделами и единой областью панелей",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.tsx",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-button-basic": "workspace:*"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-widget": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-panel": "workspace:*",
    "@zavx0z/immersive-ui-component-field-text": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*"
  }
}
