{
  "name": "@zavx0z/immersive-ui-component-widget-editor",
  "label": "Editor",
  "version": "0.0.0",
  "description": "Составной редактор с заголовком и командами приложения",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-header": "workspace:*",
    "@zavx0z/immersive-tech-text-editor": "workspace:*"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-widget": "workspace:*"
  }
}
