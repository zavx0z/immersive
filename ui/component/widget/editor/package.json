{
  "name": "@immersive-ui-component-widget/editor",
  "label": "Editor",
  "version": "0.0.0",
  "description": "Составной редактор с заголовком и командами приложения",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @immersive/headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@immersive-jsx-compiler/session": "workspace:*",
    "@immersive-ui-component-view/code-editor": "workspace:*",
    "@immersive-ui-component-widget/header": "workspace:*",
    "@immersive-tech/text-editor": "workspace:*"
  },
  "peerDependencies": {
    "@immersive/component": "workspace:*"
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@immersive-ui-component/widget": "workspace:*"
  }
}
