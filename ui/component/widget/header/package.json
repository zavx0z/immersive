{
  "name": "@zavx0z/immersive-ui-component-widget-header",
  "label": "WidgetHeader",
  "version": "0.0.0",
  "description": "Общий заголовок составного виджета со статусом и действиями",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
