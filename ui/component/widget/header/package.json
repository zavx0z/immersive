    "@zavx0z/immersive-ui-component-badge": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component-widget": "workspace:*"
  }
}
