{
  "name": "@zavx0z/immersive-ui-component-widget",
  "label": "widget",
  "version": "0.0.0",
  "description": "Виджеты составляют законченные панели с управлением и содержимым.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-widget-editor": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-header": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-inspector": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-terminal": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-tree": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-settings": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-ui-component-surface-panel": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
