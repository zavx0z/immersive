{
  "name": "@immersive-ui-component-widget/inspector",
  "label": "Inspector",
  "version": "0.0.0",
  "description": "Инспектор категорий и панелей с поиском и сохраняемым содержимым",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @immersive/headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@immersive-jsx-compiler/session": "workspace:*",
    "@immersive-ui-component-button/basic": "workspace:*",
    "@immersive-ui-component-button/icon": "workspace:*",
    "@immersive-ui-component-field/text": "workspace:*",
    "@immersive-ui-theme-icon/search": "workspace:*"
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@immersive-ui-theme-icon/run": "workspace:*",
    "@immersive-ui-component/typography": "workspace:*",
    "@immersive-ui-component/widget": "workspace:*"
  }
}
