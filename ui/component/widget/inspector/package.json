{
  "name": "@zavx0z/immersive-ui-component-widget-inspector",
  "label": "Inspector",
  "version": "0.0.0",
  "description": "Инспектор категорий и панелей с поиском и сохраняемым содержимым",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload @zavx0z/immersive-headless/preload --parallel --max-concurrency=2 ./spec ./test",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-button-basic": "workspace:*",
    "@zavx0z/immersive-ui-component-button-icon": "workspace:*",
    "@zavx0z/immersive-ui-component-field-text": "workspace:*",
    "@zavx0z/immersive-ui-theme-icon-search": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-theme-icon-run": "workspace:*",
    "@zavx0z/immersive-ui-component-typography": "workspace:*",
    "@zavx0z/immersive-ui-component-widget": "workspace:*"
  }
}
