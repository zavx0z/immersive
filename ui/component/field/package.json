{
  "name": "@zavx0z/immersive-ui-component-field",
  "label": "field",
  "version": "0.0.0",
  "description": "Поля сохраняют общий протокол подписи, подсказки и представления.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-ui-component-field-checkbox": "workspace:*",
    "@zavx0z/immersive-ui-component-field-collection": "workspace:*",
    "@zavx0z/immersive-ui-component-field-color": "workspace:*",
    "@zavx0z/immersive-ui-component-field-color-picker": "workspace:*",
    "@zavx0z/immersive-ui-component-field-cycle": "workspace:*",
    "@zavx0z/immersive-ui-component-field-group": "workspace:*",
    "@zavx0z/immersive-ui-component-field-matrix": "workspace:*",
    "@zavx0z/immersive-ui-component-field-number": "workspace:*",
    "@zavx0z/immersive-ui-component-field-path": "workspace:*",
    "@zavx0z/immersive-ui-component-field-reference": "workspace:*",
    "@zavx0z/immersive-ui-component-field-select": "workspace:*",
    "@zavx0z/immersive-ui-component-field-slider": "workspace:*",
    "@zavx0z/immersive-ui-component-field-switch": "workspace:*",
    "@zavx0z/immersive-ui-component-field-text": "workspace:*",
    "@zavx0z/immersive-ui-component-field-vector": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel --preload @zavx0z/immersive-headless/preload ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
