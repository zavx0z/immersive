{
  "name": "@immersive-ui/component",
  "label": "UI",
  "version": "0.0.0",
  "description": "Компоненты интерфейса создают JSX-представления в Document принимающего приложения.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./theme/theme.css"
  ],
  "exports": {
    ".": "./index.ts",
    "./contract": "./contract/index.ts",
    "./theme/theme.css": "./theme/theme.css",
    "./theme/field-metrics.json": "./theme/field-metrics.json",
    "./theme/islands-dark.color-theme.json": "./theme/islands-dark.color-theme.json"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel --max-concurrency=2 --preload @immersive/headless/preload --timeout 30000 ./tests ./spec ./button ./field ./feedback ./menu ./navigation ./surface ./view ./widget ./badge ./divider ./typography",
    "check": "bun run --parallel typecheck test"
  },
