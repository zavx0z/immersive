{
  "name": "@zavx0z/immersive-ui-component",
  "label": "UI",
  "version": "0.0.0",
  "description": "Компоненты интерфейса создают JSX-представления в Document принимающего приложения.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./theme/theme.css"
  ],
  "exports": {
    ".": "./index.ts",
    "./contract": "./contract/index.ts",
