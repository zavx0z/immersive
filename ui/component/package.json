  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel --max-concurrency=2 --preload @zavx0z/immersive-headless/preload --timeout 30000 ./tests ./spec ./button ./field ./feedback ./menu ./navigation ./surface ./view ./widget ./badge ./divider ./typography",
    "check": "bun run --parallel typecheck test"
  },
