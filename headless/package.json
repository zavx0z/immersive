{
  "name": "@immersive/headless",
  "label": "Без браузера",
  "version": "0.0.0",
  "description": "Без браузера: нативная отрисовка компонентов в живой DOM и PNG",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./preload": "./preload.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --preload ./preload.ts --parallel tests",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "bun-webgpu": "^0.1.7"
  },
  "peerDependencies": {
    "@immersive-renderer/html": "workspace:*",
    "@immersive/component": "workspace:*",
    "@immersive/dom": "workspace:*",
    "@immersive/engine": "workspace:*",
    "@immersive/template": "workspace:*",
    "@immersive-ui/component": "workspace:*",
    "@immersive/webgpu": "workspace:*",
    "@immersive-jsx-compiler/bun": "workspace:*",
    "@immersive-jsx-compiler/session": "workspace:*",
    "@immersive/jsx": "workspace:*",
    "@immersive-jsx-slot/child": "workspace:*",
    "@immersive-ui-component/typography": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@immersive-renderer/html": {
      "optional": true
    },
    "@immersive/component": {
      "optional": true
    },
    "@immersive/dom": {
      "optional": true
    },
    "@immersive/engine": {
      "optional": true
    },
    "@immersive/template": {
      "optional": true
    },
    "@immersive-ui/component": {
      "optional": true
    },
    "@immersive/webgpu": {
      "optional": true
    }
  }
}
