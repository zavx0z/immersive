          {
            "name": "$qwen3-8-local",
            "description": "Delegate bounded, reviewable analysis, drafting, classification, transformation, and bulk semantic-enrichment work to Qwen3.8 on the private AI-SRV. Use the controlled native Ollama tool-loop for workspace and web tasks, with plan-first execution, explicit budgets, transcripts, and token accounting. Do not use helper output as authoritative evidence or for final security, architecture, destructive, or acceptance decisions.",
            "input": null
          },
          {
            "name": "$tsdoc",
            "description": "Write or revise high-signal in-code TSDoc with Markdown structure, public-contract ownership, lifecycle, side effects, errors, and useful examples.",
            "input": null
