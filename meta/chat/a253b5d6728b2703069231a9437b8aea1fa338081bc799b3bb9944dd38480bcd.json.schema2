    {
      "id": "user:2bd5e563-ed9f-4347-a2f6-61d6977b16a5",
      "sequence": 2,
      "origin": "local",
      "kind": "message",
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "какие инструменты ты видешь у себя?"
        }
