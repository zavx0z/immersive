{
  "name": "@zavx0z/immersive-browser",
  "label": "Браузер",
  "version": "0.0.0",
  "private": true,
  "description": "Canvas, обработка изменения размеров и ввода, общий цикл кадров браузера",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./authoring": {
      "source": "./authoring.ts",
      "types": "./dist/authoring.d.ts",
      "default": "./dist/authoring.js"
    },
    "./clipboard": {
      "source": "./clipboard.ts",
      "types": "./dist/clipboard.d.ts",
      "browser": "./dist/clipboard.js",
      "default": "./dist/clipboard.js"
    },
    "./diagnostics": {
      "source": "./diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "browser": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./integration": {
      "source": "./integration.ts",
      "types": "./dist/integration.d.ts",
      "browser": "./dist/integration.js",
      "default": "./dist/integration.js"
    },
    "./audio": {
      "source": "./audio.ts",
      "types": "./dist/audio.d.ts",
      "browser": "./dist/audio.js",
      "default": "./dist/audio.js"
    },
    "./document": {
      "source": "./document/index.ts",
      "types": "./dist/document/index.d.ts",
      "browser": "./dist/document/index.js",
      "default": "./dist/document/index.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel tests",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*",
    "@zavx0z/immersive-engine": "workspace:*",
    "@zavx0z/immersive-renderer-html": "workspace:*",
    "@zavx0z/immersive-space": "workspace:*",
    "@zavx0z/immersive-webgpu": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-component": {
      "optional": true
    },
    "@zavx0z/immersive-template": {
      "optional": true
    },
    "@zavx0z/immersive-dom": {
      "optional": true
    },
    "@zavx0z/immersive-engine": {
      "optional": true
    },
    "@zavx0z/immersive-renderer-html": {
      "optional": true
    },
    "@zavx0z/immersive-space": {
      "optional": true
    },
    "@zavx0z/immersive-webgpu": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*",
    "@zavx0z/immersive-ui-component-menu-clipboard": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-tech-text-editor": "workspace:*",
    "@zavx0z/immersive-ui-component-widget-editor": "workspace:*"
  }
}
