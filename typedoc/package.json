{
  "name": "@zavx0z/immersive-typedoc",
  "label": "TypeDoc",
  "version": "0.0.0",
  "description": "Разбор TypeScript 7 и отображение документации типов",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./typedoc/index.tsx",
      "types": "./dist/typedoc/index.d.ts",
      "browser": "./dist/typedoc/index.js",
      "default": "./dist/typedoc/index.js"
    },
    "./parser": {
      "source": "./parser/index.ts",
      "types": "./dist/parser/index.d.ts",
      "default": "./dist/parser/index.js"
    },
    "./batch": {
      "source": "./batch/index.ts",
      "types": "./dist/batch/index.d.ts",
      "default": "./dist/batch/index.js"
    },
    "./contract/input": {
      "source": "./typedoc/contract/input.ts",
      "types": "./dist/typedoc/contract/input.d.ts",
      "browser": "./dist/typedoc/contract/input.js",
      "default": "./dist/typedoc/contract/input.js"
    },
    "./parser/contract/input": {
      "source": "./parser/contract/input.ts",
      "types": "./dist/parser/contract/input.d.ts",
      "browser": "./dist/parser/contract/input.js",
      "default": "./dist/parser/contract/input.js"
    },
    "./parser/contract/output": {
      "source": "./parser/contract/output.ts",
      "types": "./dist/parser/contract/output.d.ts",
      "browser": "./dist/parser/contract/output.js",
      "default": "./dist/parser/contract/output.js"
    },
    "./batch/contract/input": {
      "source": "./batch/contract/input.ts",
      "types": "./dist/batch/contract/input.d.ts",
      "browser": "./dist/batch/contract/input.js",
      "default": "./dist/batch/contract/input.js"
    },
    "./batch/contract/output": {
      "source": "./batch/contract/output.ts",
      "types": "./dist/batch/contract/output.d.ts",
      "browser": "./dist/batch/contract/output.js",
      "default": "./dist/batch/contract/output.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel tests",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-markdown": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-component": {
      "optional": true
    },
    "@zavx0z/immersive-template": {
      "optional": true
    },
    "@zavx0z/immersive-markdown": {
      "optional": true
    },
    "@zavx0z/immersive-ui-component": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-ui-view-code-editor-palette": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*",
    "@zavx0z/immersive-renderer-html": "workspace:*"
  }
}
