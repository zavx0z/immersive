{
  "name": "@immersive/markdown",
  "label": "Markdown",
  "version": "0.0.0",
  "description": "Разбор и отображение Markdown через готовые UI-компоненты",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./markdown/index.tsx",
    "./contract/input": "./markdown/contract/input.ts",
    "./parser": "./parser/index.ts",
    "./mermaid": "./mermaid/index.tsx",
    "./mermaid/contract/input": "./mermaid/contract/input.ts",
    "./parser/contract/input": "./parser/contract/input.ts",
    "./parser/contract/output": "./parser/contract/output.ts",
    "./destination": "./destination/index.ts",
    "./destination/contract/input": "./destination/contract/input.ts",
    "./destination/contract/output": "./destination/contract/output.ts",
    "./types": "./shared/types/model.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel parser/tests destination/tests markdown/tests",
    "check": "bun run --parallel typecheck test"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "parse5": "^8.0.1",
    "@nodes-node/diagram": "workspace:*"
  },
  "peerDependencies": {
    "@zavx0z/component": "workspace:*",
    "@zavx0z/dom": "workspace:*",
    "@zavx0z/template": "workspace:*",
    "@zavx0z/ui": "workspace:*",
    "@nodes/node": "workspace:*",
    "@nodes/layout": "workspace:*",
    "@immersive/nodes": "workspace:*",
    "@zavx0z/jsx": "workspace:*",
    "@jsx-compiler/session": "workspace:*",
    "@ui/divider": "workspace:*",
    "@ui-views/code-editor": "workspace:*"
  },
  "devDependencies": {
    "@renderer/html": "workspace:*",
    "@zavx0z/highlighter": "^0.1.0",
    "@jsx-compiler/bun": "workspace:*",
    "@zavx0z/ui": "workspace:*",
    "@node-geometry/project": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/dom": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    },
    "@nodes/node": {
      "optional": true
    },
    "@nodes/layout": {
      "optional": true
    },
    "@immersive/nodes": {
      "optional": true
    }
  }
}
