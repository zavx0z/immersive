{
  "name": "@zavx0z/immersive-markdown",
  "label": "Markdown",
  "version": "0.0.0",
  "description": "Разбор и отображение Markdown через готовые UI-компоненты",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./markdown/index.tsx",
      "types": "./dist/markdown/index.d.ts",
      "browser": "./dist/markdown/index.js",
      "default": "./dist/markdown/index.js"
    },
    "./contract/input": {
      "source": "./markdown/contract/input.ts",
      "types": "./dist/markdown/contract/input.d.ts",
      "browser": "./dist/markdown/contract/input.js",
      "default": "./dist/markdown/contract/input.js"
    },
    "./parser": {
      "source": "./parser/index.ts",
      "types": "./dist/parser/index.d.ts",
      "browser": "./dist/parser/index.js",
      "default": "./dist/parser/index.js"
    },
    "./mermaid": {
      "source": "./mermaid/index.tsx",
      "types": "./dist/mermaid/index.d.ts",
      "browser": "./dist/mermaid/index.js",
      "default": "./dist/mermaid/index.js"
    },
    "./mermaid/contract/input": {
      "source": "./mermaid/contract/input.ts",
      "types": "./dist/mermaid/contract/input.d.ts",
      "browser": "./dist/mermaid/contract/input.js",
      "default": "./dist/mermaid/contract/input.js"
    },
    "./parser/contract/input": {
      "source": "./parser/contract/input.ts",
      "types": "./dist/parser/contract/input.d.ts",
      "browser": "./dist/parser/contract/input.js",
      "default": "./dist/parser/contract/input.js"
    },
    "./parser/contract/output": {
      "source": "./parser/contract/output.ts",
      "types": "./dist/parser/contract/output.d.ts",
      "browser": "./dist/parser/contract/output.js",
      "default": "./dist/parser/contract/output.js"
    },
    "./destination": {
      "source": "./destination/index.ts",
      "types": "./dist/destination/index.d.ts",
      "browser": "./dist/destination/index.js",
      "default": "./dist/destination/index.js"
    },
    "./destination/contract/input": {
      "source": "./destination/contract/input.ts",
      "types": "./dist/destination/contract/input.d.ts",
      "browser": "./dist/destination/contract/input.js",
      "default": "./dist/destination/contract/input.js"
    },
    "./destination/contract/output": {
      "source": "./destination/contract/output.ts",
      "types": "./dist/destination/contract/output.d.ts",
      "browser": "./dist/destination/contract/output.js",
      "default": "./dist/destination/contract/output.js"
    },
    "./types": {
      "source": "./shared/types/model.ts",
      "types": "./dist/shared/types/model.d.ts",
      "browser": "./dist/shared/types/model.js",
      "default": "./dist/shared/types/model.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel parser/tests destination/tests markdown/tests",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "parse5": "^8.0.1",
    "@zavx0z/immersive-nodes-node-diagram": "workspace:*"
  },
  "peerDependencies": {
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-nodes-node": "workspace:*",
    "@zavx0z/immersive-nodes-layout": "workspace:*",
    "@zavx0z/immersive-nodes": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-ui-component-divider": "workspace:*",
    "@zavx0z/immersive-ui-component-view-code-editor": "workspace:*",
    "@zavx0z/immersive-ui-component-button-basic": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-renderer-html": "workspace:*",
    "@zavx0z/highlighter": "^0.1.0",
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*",
    "@zavx0z/immersive-ui-component": "workspace:*",
    "@zavx0z/immersive-nodes-geometry-node-project": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-component": {
      "optional": true
    },
    "@zavx0z/immersive-dom": {
      "optional": true
    },
    "@zavx0z/immersive-template": {
      "optional": true
    },
    "@zavx0z/immersive-ui-component": {
      "optional": true
    },
    "@zavx0z/immersive-nodes-node": {
      "optional": true
    },
    "@zavx0z/immersive-nodes-layout": {
      "optional": true
    },
    "@zavx0z/immersive-nodes": {
      "optional": true
    }
  }
}
