{
  "name": "@zavx0z/immersive-tech-json-patch",
  "label": "tech/json/patch",
  "version": "0.0.0",
  "description": "Применяет ограниченный JSON Patch атомарно к собственной копии данных",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-tech-json-value-own": "workspace:*",
    "@zavx0z/immersive-tech-json-value-equal": "workspace:*",
    "@zavx0z/immersive-tech-json-patch-error": "workspace:*",
    "@zavx0z/immersive-tech-json-patch-limits": "workspace:*"
  }
}
