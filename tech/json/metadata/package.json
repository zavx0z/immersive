{
  "name": "@zavx0z/immersive-tech-json-metadata",
  "label": "Метаданные модели",
  "version": "0.0.0",
  "description": "Читатели JSON-метаданных с общим протоколом источника и имени поля",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "source": "./contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-tech-json-value-own": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-read": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-string": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-number": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-boolean": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-string-array": "workspace:*",
    "@zavx0z/immersive-tech-json-metadata-object-array": "workspace:*"
  },
  "scripts": {
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel ./spec",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  }
}
