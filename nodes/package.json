    "@nodes/sockets": "workspace:*",
    "@zavx0z/template": "workspace:*",
    "@zavx0z/ui": "workspace:*",
    "@nodes/node": "workspace:*",
    "@zavx0z/jsx": "workspace:*",
    "@ui-buttons/button": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/dom": {
      "optional": true
    },
    "@nodes/layout": {
      "optional": true
    },
    "@nodes/tree": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
