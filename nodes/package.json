{
  "name": "@immersive/nodes",
  "label": "Нодовая система",
  "version": "0.0.0",
  "description": "Общее представление GraphView, GraphEditor, Frame и Link",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./view": "./view/index.tsx",
    "./view/contract/input": "./view/contract/input.ts",
    "./view/tree": "./view/tree.ts",
    "./editor": "./editor/index.tsx",
    "./editor/contract/input": "./editor/contract/input.ts",
    "./frame": "./frame/index.tsx",
    "./frame/contract/input": "./frame/contract/input.ts",
    "./link": "./link/index.tsx",
    "./link/contract/input": "./link/contract/input.ts",
    "./link/types": "./link/types/link.ts",
    "./routing/link-path": "./shared/routing/link-path.ts",
    "./marker": "./marker/index.ts",
    "./marker/arrow": "./marker/arrow/index.tsx",
    "./marker/arrow/contract/input": "./marker/arrow/contract/input.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel ./tests ./frame/tests ./view/tests ./frame/spec ./marker/arrow/spec",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
