{
  "name": "@zavx0z/immersive-nodes-model-parameter-store",
  "label": "nodes/model/parameter/store",
  "version": "0.0.0",
  "description": "Хранит значение параметра, выпускает снимки и уведомляет подписчиков после изменения",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel ./spec",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-tech-json-value-own": "workspace:*",
    "@zavx0z/immersive-tech-json-value-equal": "workspace:*",
    "@zavx0z/immersive-nodes-model-parameter-value-type": "workspace:*"
  }
}
