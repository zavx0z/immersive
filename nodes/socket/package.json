{
  "name": "@nodes/sockets",
  "label": "Сокет",
  "version": "0.0.0",
  "description": "Адресуемый визуальный сокет с внешним состоянием и обработчиком активации",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests spec/deps.spec.ts && bun test --preload @immersive/headless/preload spec/scenario.spec.tsx",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependenciesMeta": {
    "@nodes/tree": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@nodes/tree": "workspace:*",
    "@zavx0z/component": "workspace:*",
    "@zavx0z/template": "workspace:*",
    "@zavx0z/jsx": "workspace:*"
  },
  "devDependencies": {
    "@jsx-compiler/bun": "workspace:*",
    "@immersive/headless": "workspace:*"
  },
  "dependencies": {
    "@socket-values/kinds": "workspace:*",
    "@socket-values/shapes": "workspace:*",
    "@socket-values/presets": "workspace:*",
    "@socket-values/preset": "workspace:*",
    "@socket-values/metrics": "workspace:*",
    "@jsx-compiler/session": "workspace:*"
  }
}
