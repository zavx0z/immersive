{
  "name": "@zavx0z/immersive-nodes-socket",
  "label": "Сокет",
  "version": "0.0.0",
  "description": "Адресуемый визуальный сокет с внешним состоянием и обработчиком активации",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests spec/deps.spec.ts && bun test --preload @zavx0z/immersive-headless/preload spec/scenario.spec.tsx",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-nodes-tree": {
      "optional": true
    },
    "@zavx0z/immersive-component": {
      "optional": true
    },
    "@zavx0z/immersive-template": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@zavx0z/immersive-nodes-tree": "workspace:*",
    "@zavx0z/immersive-component": "workspace:*",
    "@zavx0z/immersive-template": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*",
    "@zavx0z/immersive-headless": "workspace:*"
  },
  "dependencies": {
    "@zavx0z/immersive-nodes-model-socket-kinds": "workspace:*",
    "@zavx0z/immersive-nodes-model-socket-shapes": "workspace:*",
    "@zavx0z/immersive-nodes-model-socket-presets": "workspace:*",
    "@zavx0z/immersive-nodes-model-socket-preset": "workspace:*",
    "@zavx0z/immersive-nodes-model-socket-metrics": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  }
}
