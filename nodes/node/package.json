    "@ui-themes-icons/visibility-on": "workspace:*",
    "@ui-buttons/icon-button": "workspace:*",
    "@ui-themes-icons/chevron-down": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nodes/tree": {
      "optional": true
    },
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    }
