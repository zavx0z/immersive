{
  "name": "@nodes/node",
  "label": "Ноды",
  "version": "0.0.0",
  "description": "Ноды диаграмм, параметров и произвольного содержимого",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./diagram": "./diagram/index.tsx",
    "./diagram/contract/input": "./diagram/contract/input.ts",
    "./parameter": "./parameter/index.tsx",
    "./parameter/contract/input": "./parameter/contract/input.ts",
    "./content": "./content/index.tsx",
    "./content/contract/input": "./content/contract/input.ts",
    "./geometry": "./shared/geometry.ts",
    "./contracts": "./shared/contracts.ts",
    "./metrics": "./shared/metrics.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests && bun test --preload @immersive/headless/preload --parallel diagram/spec content/spec parameter/spec",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@nodes/tree": "workspace:*",
    "@nodes/parameters": "workspace:*",
    "@nodes/sockets": "workspace:*",
    "@zavx0z/component": "workspace:*",
    "@zavx0z/template": "workspace:*",
    "@zavx0z/ui": "workspace:*",
    "@zavx0z/jsx": "workspace:*",
    "@jsx-compiler/session": "workspace:*",
    "@ui-surfaces/pane": "workspace:*",
    "@ui-themes-icons/chevron-right": "workspace:*",
    "@ui-buttons/button": "workspace:*",
    "@ui/typography": "workspace:*",
    "@ui-themes-icons/visibility-on": "workspace:*",
    "@ui-buttons/icon-button": "workspace:*",
    "@ui-themes-icons/chevron-down": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nodes/tree": {
      "optional": true
    },
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@immersive/headless": "workspace:*",
    "@jsx-compiler/bun": "workspace:*"
  }
}
