{
  "name": "@nodes/node",
  "label": "Ноды",
  "version": "0.0.0",
  "description": "Ноды диаграмм, параметров и произвольного содержимого",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "exports": {
    "./diagram": "./diagram/index.tsx",
    "./diagram/contract/input": "./diagram/contract/input.ts",
    "./parameter": "./parameter/index.tsx",
    "./parameter/contract/input": "./parameter/contract/input.ts",
    "./content": "./content/index.tsx",
    "./content/contract/input": "./content/contract/input.ts",
    "./geometry": "./shared/geometry.ts",
    "./contracts": "./shared/contracts.ts",
    "./metrics": "./shared/metrics.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test tests --max-concurrency=1 && bun test --preload @immersive/headless/preload diagram/spec content/spec parameter/spec --max-concurrency=1",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@nodes/tree": "*",
    "@nodes/parameters": "*",
    "@nodes/sockets": "*",
    "@zavx0z/component": "*",
    "@zavx0z/template": "*",
    "@zavx0z/ui": "*"
  },
  "peerDependenciesMeta": {
    "@nodes/tree": {
      "optional": true
    },
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@immersive/headless": "*"
  }
}
