{
  "name": "@zavx0z/immersive-renderer-html",
  "label": "HTML",
  "version": "0.0.0",
  "private": true,
  "description": "CSS, размеры, раскладка, прокрутка, список рисования и проверка попаданий без GPU",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./frame-changes": {
      "source": "./src/frame-changes.ts",
      "types": "./dist/src/frame-changes.d.ts",
      "browser": "./dist/src/frame-changes.js",
      "default": "./dist/src/frame-changes.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel tests",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/immersive-dom": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-dom": {
      "optional": true
    }
  },
  "license": "MIT"
}
