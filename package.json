{
  "name": "@zavx0z/immersive",
  "label": "Immersive",
  "version": "0.0.0",
  "description": "Единая Immersive-платформа MetaFor",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.x"
  },
  "workspaces": [
    "**",
    "!**/{node_modules,spec,test,tests,fixture,fixtures,dist,projects}/**",
    "!**/.*/**"
  ],
  "scripts": {
    "typecheck": "bun run --parallel typecheck:root typecheck:packages",
    "typecheck:root": "tsc --project tsconfig.json --pretty false",
    "typecheck:packages": "bun run --workspaces --sequential typecheck",
    "test": "bun run --parallel test:architecture test:packages",
    "test:architecture": "bun test --parallel --timeout 30000 tests/architecture/packages.test.ts tests/architecture/dependencies.test.ts tests/experience/contract.test.ts",
    "test:packages": "bun run --workspaces --sequential test",
    "check": "bun run --parallel typecheck test"
  },
  "devDependencies": {
    "@zavx0z/immersive-browser": "workspace:*",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "@zavx0z/immersive-jsx": "workspace:*",
    "@zavx0z/immersive-dom": "workspace:*"
  },
  "overrides": {
    "@zavx0z/highlighter": "link:@zavx0z/highlighter"
  }
}
