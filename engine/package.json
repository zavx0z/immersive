{
  "name": "@zavx0z/immersive-engine",
  "label": "Движок",
  "version": "0.0.0",
  "private": true,
  "description": "Объекты сцены, геометрия, материалы, математика и анимация без WebGPU",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./default-font": {
      "source": "./src/text/default-font.ts",
      "types": "./dist/src/text/default-font.d.ts",
      "browser": "./dist/src/text/default-font.js",
      "default": "./dist/src/text/default-font.js"
    },
    "./fonts/inter-regular.ttf": "./static/font/inter-regular.ttf",
    "./fonts/inter-bold.ttf": "./static/font/inter-bold.ttf",
    "./fonts/inter-italic.ttf": "./static/font/inter-italic.ttf",
    "./fonts/inter-bold-italic.ttf": "./static/font/inter-bold-italic.ttf",
    "./fonts/jetbrains-mono-regular.ttf": "./static/font/jetbrains-mono-regular.ttf",
    "./fonts/jetbrains-mono-italic.ttf": "./static/font/jetbrains-mono-italic.ttf",
    "./fonts/jetbrains-mono-bold-italic.ttf": "./static/font/jetbrains-mono-bold-italic.ttf",
    "./fonts/jetbrains-mono-bold.ttf": "./static/font/jetbrains-mono-bold.ttf"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel tests",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "license": "MIT"
}
