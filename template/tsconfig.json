{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve",
    "jsxImportSource": "@immersive/jsx"
  },
  "include": [
    "*.ts",
    "attribute/**/*.ts",
    "node/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "css-shape/**/*.ts"
  ]
}
