{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve",
    "jsxImportSource": "@zavx0z/template"
  },
  "include": [
    "*.ts",
    "attribute/**/*.ts",
    "compiler/**/*.ts",
    "node/**/*.ts",
    "slot/**/*.ts",
    "slot/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
