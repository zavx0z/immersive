{
  "name": "@zavx0z/immersive-template",
  "label": "Шаблоны",
  "version": "0.0.0",
  "description": "HTML, CSS и общий формат готового шаблона",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compiled": {
      "source": "./compiled.ts",
      "types": "./dist/compiled.d.ts",
      "browser": "./dist/compiled.js",
      "default": "./dist/compiled.js"
    },
    "./css-shape": {
      "source": "./css-shape/index.ts",
      "types": "./dist/css-shape/index.d.ts",
      "browser": "./dist/css-shape/index.js",
      "default": "./dist/css-shape/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel tests css-shape/spec",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/immersive-dom": "workspace:*",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*"
  }
}
