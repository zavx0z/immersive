{
  "name": "@zavx0z/immersive-template",
  "label": "Шаблоны",
  "version": "0.0.0",
  "description": "HTML, CSS и общий формат готового шаблона",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./compiled": "./compiled.ts",
    "./css-shape": "./css-shape/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests css-shape/spec",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/immersive-dom": "workspace:*",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@zavx0z/immersive-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-jsx": "workspace:*"
  }
}
