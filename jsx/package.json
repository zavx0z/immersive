{
  "name": "@zavx0z/immersive-jsx",
  "label": "JSX",
  "version": "0.0.0",
  "description": "Авторский JSX, автоматический protocol, слоты и компиляция",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./index.ts",
      "node": "./index.ts"
    },
    "./jsx-runtime": {
      "source": "./runtime/index.ts",
      "types": "./runtime/dist/index.d.ts",
      "default": "./runtime/dist/index.js"
    },
    "./jsx-dev-runtime": {
      "source": "./development/index.ts",
      "types": "./development/dist/index.d.ts",
      "default": "./development/dist/index.js"
    }
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-runtime": "workspace:*",
    "@zavx0z/immersive-jsx-development": "workspace:*",
    "@zavx0z/immersive-jsx-slot": "workspace:*",
    "@zavx0z/immersive-jsx-event": "workspace:*",
    "@zavx0z/immersive-jsx-compiler": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "devDependencies": {
    "@zavx0z/immersive-jsx-runtime-create": "workspace:*",
    "@zavx0z/immersive-jsx-runtime-fragment": "workspace:*",
    "@zavx0z/immersive-jsx-slot-plan": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*",
    "@zavx0z/immersive-jsx-compiler-bun": "workspace:*"
  }
}
