{
  "name": "@zavx0z/jsx",
  "label": "JSX",
  "version": "0.0.0",
  "description": "Авторский JSX, автоматический protocol, слоты и компиляция",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./index.ts",
      "node": "./index.ts"
    },
    "./jsx-runtime": "./runtime/index.ts",
    "./jsx-dev-runtime": "./development/index.ts"
  },
  "dependencies": {
    "@jsx/runtime": "*",
    "@jsx/development": "*",
    "@jsx/slot": "*",
    "@jsx/events": "*",
    "@jsx/compiler": "*"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel ./test",
    "check": "bun run --parallel typecheck test"
  },
  "devDependencies": {
    "@jsx-runtime/create": "*",
    "@jsx-runtime/fragment": "*",
    "@jsx-slot/plan": "*",
    "@jsx-compiler/session": "*",
    "@jsx-compiler/bun": "*"
  }
}
