{
  "name": "@zavx0z/immersive-jsx-compiler-bun",
  "label": "JSX в Bun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "BUN_OPTIONS=--conditions=source bun test --parallel ./spec ./test",
    "check": "BUN_OPTIONS=--conditions=source bun run --parallel typecheck test"
  },
  "dependencies": {
    "@zavx0z/immersive-jsx-compiler-session": "workspace:*"
  },
  "description": "Интеграция компилятора JSX со сборкой Bun",
  "sideEffects": false,
  "devDependencies": {
    "@zavx0z/immersive-jsx": "workspace:*"
  }
}
